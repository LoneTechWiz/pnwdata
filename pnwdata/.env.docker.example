# Politics & War data source
PNW_API_KEY=
PUBLIC_APP_URL=http://localhost:3000

# Website session signing (Discord OAuth credentials belong only in darth-protocol)
SESSION_SECRET=

# Shared secret used for pnwdata <-> darth-protocol service calls
BOT_SERVICE_TOKEN=
DARTH_PROTOCOL_URL=http://host.docker.internal:3100

# Optional local Ollama endpoint and published web port
PNWDATA_PORT=3000
